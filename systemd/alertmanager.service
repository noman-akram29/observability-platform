[Unit]
Description=Alertmanager
After=network.target

[Service]
Type=simple
User=nomanakram
WorkingDirectory=/home/nomanakram/observability-lab
ExecStart=/usr/local/bin/alertmanager --config.file=alertmanager/alertmanager.yml --storage.path=alertmanager/data
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
